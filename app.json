{
  "expo": {
    "name": "CookstoveCare",
    "slug": "cookstovecare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.cookstovecare",
      "infoPlist": {
        "NSCameraUsageDescription": "CookstoveCare needs camera access to take photos of cookstoves and delivery handovers.",
        "NSPhotoLibraryUsageDescription": "CookstoveCare needs photo library access to select cookstove photos."
      }
    },
    "android": {
      "package": "com.meensou.cookstovecare",
      "adaptiveIcon": {
        "backgroundColor": "#673AB7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CookstoveCare to access your camera to capture cookstove conditions and delivery photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CookstoveCare to access your photos to select cookstove condition records."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a93ead7d-85b0-4722-a179-2e622e606edc"
      }
    },
    "owner": "subham19"
  }
}
